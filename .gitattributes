# Text files are normalized to LF in the repository and checked out with LF on every
# platform, regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

#
# Source code
#
*.cs        text eol=lf diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text

#
# Documentation and configuration
#
*.md        text diff=markdown
*.json      text
*.yml       text
*.yaml      text
*.toml      text
*.py        text diff=python
*.config    text
*.editorconfig text
.gitattributes text
.gitignore  text
LICENSE     text

#
# Binary files (never normalize or diff as text)
#
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.snk       binary
*.pfx       binary
*.dll       binary
*.exe       binary
*.nupkg     binary
*.snupkg    binary
